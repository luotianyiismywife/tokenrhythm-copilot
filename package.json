{
	"name": "tokenrhythm-copilot-provider",
	"publisher": "luotianyiismywife",
	"displayName": "TokenRhythm Provider for Copilot",
	"description": "Integrate TokenRhythm models into GitHub Copilot Chat",
	"keywords": [
		"ai",
		"chat",
		"copilot",
		"github-copilot",
		"language-models",
		"llm",
		"tokenrhythm",
		"openai-compatible",
		"thinking",
		"git-commit"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/luotianyiismywife/tokenrhythm-copilot"
	},
	"homepage": "https://github.com/luotianyiismywife/tokenrhythm-copilot",
	"bugs": {
		"url": "https://github.com/luotianyiismywife/tokenrhythm-copilot/issues"
	},
	"version": "1.10.1",
	"engines": {
		"vscode": "^1.116.0"
	},
	"categories": [
		"AI",
		"Chat"
	],
	"license": "AGPL-3.0",
	"activationEvents": [
		"onStartupFinished"
	],
	"contributes": {
		"languageModelChatProviders": [
			{
				"vendor": "tokenrhythm",
				"displayName": "%providerDisplayName%",
				"managementCommand": "tokenrhythm.setApiKey"
			}
		],
		"commands": [
			{
				"command": "tokenrhythm.setApiKey",
				"category": "%commandCategory%",
				"title": "%command.setApiKey%"
			},
			{
				"command": "tokenrhythm.getApiKey",
				"category": "%commandCategory%",
				"title": "%command.getApiKey%"
			},
			{
				"command": "tokenrhythm.openSettings",
				"category": "%commandCategory%",
				"title": "%command.openSettings%"
			},
			{
				"command": "tokenrhythm.generateGitCommitMessage",
				"title": "%command.generateCommit%",
				"category": "%commandCategory%",
				"icon": "$(wand)"
			},
			{
				"command": "tokenrhythm.abortGitCommitMessage",
				"title": "%command.abortCommit%",
				"category": "%commandCategory%",
				"icon": "$(debug-stop)"
			},
			{
				"command": "tokenrhythm.setModelPreset",
				"category": "%commandCategory%",
				"title": "%command.setModelPreset%"
			},
			{
				"command": "tokenrhythm.manageApiKeys",
				"category": "%commandCategory%",
				"title": "%command.manageApiKeys%"
			},
			{
				"command": "tokenrhythm.setVisionProxyModel",
				"category": "%commandCategory%",
				"title": "%command.setVisionProxyModel%"
			}
		],
		"walkthroughs": [
			{
				"id": "tokenRhythmGettingStarted",
				"title": "%walkthrough.title%",
				"description": "%walkthrough.description%",
				"steps": [
					{
						"id": "setApiKey",
						"title": "%walkthrough.setApiKey.title%",
						"description": "%walkthrough.setApiKey.description%",
						"media": {
							"markdown": "resources/walkthrough/set-api-key.md"
						},
						"completionEvents": [
							"onCommand:tokenrhythm.setApiKey"
						]
					},
					{
						"id": "showModels",
						"title": "%walkthrough.showModels.title%",
						"description": "%walkthrough.showModels.description%",
						"media": {
							"markdown": "resources/walkthrough/show-models.md"
						}
					},
					{
						"id": "advancedSettings",
						"title": "%walkthrough.advancedSettings.title%",
						"description": "%walkthrough.advancedSettings.description%",
						"media": {
							"markdown": "resources/walkthrough/advanced-settings.md"
						}
					}
				]
			}
		],
		"menus": {
			"scm/title": [
				{
					"command": "tokenrhythm.generateGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && !tokenrhythm.isGeneratingCommit"
				},
				{
					"command": "tokenrhythm.abortGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && tokenrhythm.isGeneratingCommit"
				}
			],
			"commandPalette": [
				{
					"command": "tokenrhythm.generateGitCommitMessage",
					"when": "config.git.enabled && !tokenrhythm.isGeneratingCommit"
				},
				{
					"command": "tokenrhythm.abortGitCommitMessage",
					"when": "config.git.enabled && tokenrhythm.isGeneratingCommit"
				}
			]
		},
		"configuration": {
			"title": "%config.title%",
			"properties": {
				"tokenrhythm.commitLanguage": {
					"type": "string",
					"default": "auto",
					"enum": [
						"auto",
						"English",
						"French",
						"Italian",
						"German",
						"Spanish",
						"Russian",
						"Chinese (Simplified)",
						"Chinese (Traditional)",
						"Japanese",
						"Korean",
						"Czech",
						"Portuguese (Brazil)",
						"Turkish",
						"Polish"
					],
					"enumDescriptions": [
						"%config.commitLanguage.auto.desc%",
						"%config.commitLanguage.enum.English.desc%",
						"%config.commitLanguage.enum.French.desc%",
						"%config.commitLanguage.enum.Italian.desc%",
						"%config.commitLanguage.enum.German.desc%",
						"%config.commitLanguage.enum.Spanish.desc%",
						"%config.commitLanguage.enum.Russian.desc%",
						"%config.commitLanguage.enum.ChineseSimplified.desc%",
						"%config.commitLanguage.enum.ChineseTraditional.desc%",
						"%config.commitLanguage.enum.Japanese.desc%",
						"%config.commitLanguage.enum.Korean.desc%",
						"%config.commitLanguage.enum.Czech.desc%",
						"%config.commitLanguage.enum.PortugueseBrazil.desc%",
						"%config.commitLanguage.enum.Turkish.desc%",
						"%config.commitLanguage.enum.Polish.desc%"
					],
					"description": "%config.commitLanguage.desc%"
				},
				"tokenrhythm.commitModel": {
					"type": "string",
					"default": "deepseek-v4-flash",
					"description": "%config.commitModel.desc%"
				},
				"tokenrhythm.commitMessagePrompt": {
					"type": "string",
					"default": "",
					"description": "%config.commitMessagePrompt.desc%"
				},
				"tokenrhythm.requestTimeout": {
					"type": "number",
					"default": 600000,
					"minimum": 10000,
					"description": "%config.requestTimeout.desc%"
				},
				"tokenrhythm.recentCommitsCount": {
					"type": "number",
					"default": 10,
					"minimum": 0,
					"maximum": 50,
					"description": "%config.recentCommitsCount.desc%"
				},
				"tokenrhythm.commitIncludeCommitDiff": {
					"type": "boolean",
					"default": false,
					"description": "%config.commitIncludeCommitDiff.desc%"
				},
				"tokenrhythm.commitAttachContextFiles": {
					"type": "boolean",
					"default": true,
					"description": "%config.commitAttachContextFiles.desc%"
				},
				"tokenrhythm.modelPreset": {
					"type": "string",
					"default": "precise",
					"description": "%config.modelPreset.desc%",
					"editPresentation": "singlelineText"
				},
				"tokenrhythm.temperature": {
					"type": "number",
					"default": null,
					"minimum": 0,
					"maximum": 2,
					"description": "%config.temperature.desc%"
				},
				"tokenrhythm.top_p": {
					"type": "number",
					"default": null,
					"minimum": 0,
					"maximum": 1,
					"description": "%config.top_p.desc%"
				},
				"tokenrhythm.enableAutoModelDiscovery": {
					"type": "boolean",
					"default": true,
					"description": "%config.enableAutoModelDiscovery.desc%"
				},
				"tokenrhythm.syncModelsOnStartup": {
					"type": "boolean",
					"default": true,
					"description": "%config.syncModelsOnStartup.desc%"
				},
				"tokenrhythm.maxInputTokensRatio": {
					"type": "number",
					"default": 1.0,
					"minimum": 0.1,
					"maximum": 1.0,
					"description": "%config.maxInputTokensRatio.desc%"
				},
				"tokenrhythm.modelPresets": {
					"type": "array",
					"default": [
						{
							"id": "precise",
							"label": "Precise",
							"temperature": 0
						},
						{
							"id": "balanced",
							"label": "Balanced",
							"temperature": 1
						},
						{
							"id": "creative",
							"label": "Creative",
							"temperature": 1.2
						},
						{
							"id": "extra-creative",
							"label": "Extra Creative",
							"temperature": 1.7
						}
					],
					"items": {
						"type": "object",
						"required": [
							"id",
							"label",
							"temperature"
						],
						"properties": {
							"id": {
								"type": "string",
								"description": "%config.modelPreset.id.desc%"
							},
							"label": {
								"type": "string",
								"description": "%config.modelPreset.label.desc%"
							},
							"temperature": {
								"type": "number",
								"description": "%config.modelPreset.temperature.desc%"
							},
							"top_p": {
								"type": "number",
								"description": "%config.modelPreset.top_p.desc%"
							}
						}
					},
					"description": "%config.modelPresets.desc%"
				},
				"tokenrhythm.visionProxyModel": {
					"type": "string",
					"default": "kimi-k2.6",
					"enum": [
						"kimi-k2.5",
						"kimi-k2.6",
						"kimi-k2.7-code",
						"qwen3.8-max",
						"seed-2.1-turbo",
						"seed-2.1-pro"
					],
					"enumDescriptions": [
						"%config.visionProxyModel.enum.kimi-k2.5.desc%",
						"%config.visionProxyModel.enum.kimi-k2.6.desc%",
						"%config.visionProxyModel.enum.kimi-k2.7-code.desc%",
						"%config.visionProxyModel.enum.qwen3.8-max.desc%",
						"%config.visionProxyModel.enum.seed-2.1-turbo.desc%",
						"%config.visionProxyModel.enum.seed-2.1-pro.desc%"
					],
					"editPresentation": "multilineText",
					"description": "%config.visionProxyModel.desc%"
				},
				"tokenrhythm.visionProxyThinking": {
					"type": "boolean",
					"default": false,
					"description": "%config.visionProxyThinking.desc%"
				},
				"tokenrhythm.enableThirdPartyTokenIndicator": {
					"type": "boolean",
					"default": true,
					"description": "%config.enableThirdPartyTokenIndicator.desc%"
				},
				"tokenrhythm.apiMode": {
					"type": "string",
					"default": "auto",
					"enum": ["auto", "openai", "anthropic", "responses"],
					"enumDescriptions": [
						"%config.apiMode.enum.auto.desc%",
						"%config.apiMode.enum.openai.desc%",
						"%config.apiMode.enum.anthropic.desc%",
						"%config.apiMode.enum.responses.desc%"
					],
					"description": "%config.apiMode.desc%"
				},
				"tokenrhythm.enableResponsesApi": {
					"type": "boolean",
					"default": false,
					"description": "%config.enableResponsesApi.desc%"
				},
				"tokenrhythm.enableAnthropicApi": {
					"type": "boolean",
					"default": false,
					"description": "%config.enableAnthropicApi.desc%"
				},
				"tokenrhythm.apiKeyMode": {
					"type": "string",
					"enum": ["sticky", "rotation", "single"],
					"default": "sticky",
					"enumDescriptions": [
						"%config.apiKeyMode.enum.sticky.desc%",
						"%config.apiKeyMode.enum.rotation.desc%",
						"%config.apiKeyMode.enum.single.desc%"
					],
					"description": "%config.apiKeyMode.desc%"
				},
				"tokenrhythm.singleKeyFallback": {
					"type": "string",
					"enum": ["error", "switch"],
					"default": "error",
					"enumDescriptions": [
						"%config.singleKeyFallback.enum.error.desc%",
						"%config.singleKeyFallback.enum.switch.desc%"
					],
					"description": "%config.singleKeyFallback.desc%"
				},
				"tokenrhythm.apiKeyRotationStatusCodes": {
					"type": "array",
					"items": {
						"type": "number"
					},
					"default": [401, 402, 429, 503],
					"description": "%config.apiKeyRotationStatusCodes.desc%"
				},
				"tokenrhythm.apiKeyRotationErrorPatterns": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": ["余额不足", "insufficient balance", "INSUFFICIENT_BALANCE", "balance", "RATE_LIMITED", "UPSTREAM_RATE_LIMITED"],
					"description": "%config.apiKeyRotationErrorPatterns.desc%"
				},
				"tokenrhythm.transientRetryStatusCodes": {
					"type": "array",
					"items": {
						"type": "number"
					},
					"default": [429, 503],
					"description": "%config.transientRetryStatusCodes.desc%"
				},
				"tokenrhythm.apiKeyExhaustedCooldownMin": {
					"type": "number",
					"default": 10,
					"minimum": 0,
					"description": "%config.apiKeyExhaustedCooldownMin.desc%"
				},
				"tokenrhythm.transientRetryTimes": {
					"type": "number",
					"default": 3,
					"minimum": 0,
					"maximum": 10,
					"description": "%config.transientRetryTimes.desc%"
				},
				"tokenrhythm.balanceCheckEnabled": {
					"type": "boolean",
					"default": true,
					"description": "%config.balanceCheckEnabled.desc%"
				},
				"tokenrhythm.minBalanceCny": {
					"type": "number",
					"default": 0,
					"minimum": 0,
					"description": "%config.minBalanceCny.desc%"
				},
				"tokenrhythm.balanceCheckIntervalSec": {
					"type": "number",
					"default": 60,
					"minimum": 0,
					"description": "%config.balanceCheckIntervalSec.desc%"
				}
			}
		}
	},
	"main": "./out/extension.js",
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./ && node scripts/build-info.mjs",
		"lint": "eslint",
		"watch": "tsc -watch -p ./",
		"build": "node scripts/package-vsix.mjs",
		"postinstall": "node scripts/copy-tokenizer.js"
	},
	"dependencies": {
		"@microsoft/tiktokenizer": "^1.0.10"
	},
	"devDependencies": {
		"@eslint/js": "9.39.4",
		"@types/node": "^22",
		"@types/vscode": "^1.116.0",
		"eslint": "9.39.4",
		"typescript": "^5.9.2",
		"typescript-eslint": "8.60.1"
	}
}
